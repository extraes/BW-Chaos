    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Debug;Release;Debug - Nobonelib</Configurations>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>11</LangVersion>
